{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "exit 0",
  "installCommand": "exit 0",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/contract",
      "destination": "/data/contract.json"
    },
    {
      "source": "/api/price",
      "destination": "/data/price.json"
    },
    {
      "source": "/api/news",
      "destination": "/data/news.json"
    },
    {
      "source": "/api/library",
      "destination": "/data/library.json"
    },
    {
      "source": "/api/projects",
      "destination": "/data/projects.json"
    },
    {
      "source": "/build",
      "destination": "/build.html"
    },
    {
      "source": "/library",
      "destination": "/library.html"
    },
    {
      "source": "/projects",
      "destination": "/projects.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/roadmap",
      "destination": "/roadmap.html"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}